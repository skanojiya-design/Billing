# Copy this file to .env before running the app:  cp .env.example .env
# (Windows PowerShell:  copy .env.example .env)

# ---------------------------------------------------------------------------
# Database — PostgreSQL (managed: Neon or Supabase recommended).
# Create a free project, copy its connection string, and paste it here.
# Use the SAME value locally and in your host (Vercel) so both share one DB.
#
#   Neon example:
#     DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require"
#   Supabase example (use the "Connection pooling" URI for serverless hosts):
#     DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/roqit?sslmode=require"

# Secret used to sign login session cookies. Use a long random string (32+ chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# Days before a payment due date to send a "due soon" email reminder.
ALERT_DUE_SOON_DAYS="5"

# Optional: require a key on GET /api/cron/run-alerts (leave unset for local dev).
# CRON_SECRET="some-long-random-value"
